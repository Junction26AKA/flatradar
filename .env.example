CONTEXT_DEV_API_KEY=
MONGODB_URI=
MONGODB_DB=flatradar
SENDGRID_API_KEY=
SENDGRID_FROM=
DIGITRANSIT_KEY=
PUBLIC_URL=
ADMIN_TOKEN=
SCORER_URL=
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash   (optional; this is the default)
# Cloudinary (listing photos, AI Vision photo flags, share cards, upload widget on /mock).
# Copy "API environment variable" from the Cloudinary console dashboard. Then: npm run cloudinary-setup
CLOUDINARY_URL=
# CLOUDINARY_UPLOAD_PRESET=flatradar_demo   (optional; unsigned preset for the /mock upload widget)
# CLOUDINARY_AI_VISION=0                    (optional; skip AI Vision tagging)
# CLOUDINARY_VISION_PHOTOS=4                (optional; photos per listing sent to AI Vision)
# Per-listing Context.dev monitors (lib/listing-monitors.mjs). 0/unset = off. 1 credit per run.
# LISTING_MONITOR_MAX=1200
# LISTING_MONITOR_HOURS=2
# PRICE_SWEEP_MINUTES=60                    (defaults to 0 while listing monitors are on)
